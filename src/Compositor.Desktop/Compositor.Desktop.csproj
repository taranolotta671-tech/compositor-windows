<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Compositor.Core\Compositor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
  </ItemGroup>

  <PropertyGroup>
    <!-- The same version as the Mac build this port follows, so Help ▸ Check for Updates compares like
         with like against the one feed both builds read. -->
    <Version>1.3.7</Version>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The canvas copies a rendered piece into the screen's pixel order. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The Mac build's app icon, converted from Compositor/Assets.xcassets/AppIcon.appiconset
         so the Windows build carries the same mark in Explorer, the taskbar and the title bar. -->
    <ApplicationIcon>Assets\compositor.ico</ApplicationIcon>
    <!-- This branch is Windows-only, so the executable is published for the one platform it runs on.
         Naming the runtime is what keeps a publish to the x64 natives: without it the runtimes folder
         carries the same libraries for Linux and macOS too, and for x86 and arm64 beside them, which
         is 866 MB of output where 180 MB does the same work. Self-contained stays off so the .NET 10
         runtime is the machine's rather than a second copy inside the folder. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded so Window.Icon can be set from the same file the executable is stamped with. -->
    <AvaloniaResource Include="Assets\compositor.ico" />
  </ItemGroup>

  <!-- A published build ships the executable, not the symbols. SkiaSharp and HarfBuzzSharp arrive
       with their own .pdb files — 116 MB of them — which nothing reads at run time. `dotnet build`
       still writes the symbols beside the assemblies in bin/, so debugging is unaffected. -->
  <Target Name="DropDebugSymbolsFromPublish" AfterTargets="Publish">
    <ItemGroup>
      <DroppedSymbols Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(DroppedSymbols)" />
    <Message Importance="high"
             Text="Dropped @(DroppedSymbols->Count()) debug symbol file(s) from $(PublishDir)" />
  </Target>

</Project>
